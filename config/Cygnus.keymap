#define ZMK_POINTING_DEFAULT_SCRL_VAL 120    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 4
#define SCROLL 5
#define NUM 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        Escape {
            bindings = <&kp ESCAPE>;
            key-positions = <1 2>;
        };

        TAb.combo {
            bindings = <&kp TAB>;
            key-positions = <13 14>;
        };

        cntll {
            bindings = <&kp LCTRL>;
            key-positions = <41 42>;
        };

        lsft {
            bindings = <&kp LSHFT>;
            key-positions = <27 28>;
        };

        mouse1 {
            bindings = <&mkp LCLK>;
            key-positions = <21 22>;
        };

        mouse2 {
            bindings = <&mkp RCLK>;
            key-positions = <22 23>;
        };

        mouse3 {
            bindings = <&mkp MCLK>;
            key-positions = <21 22 23>;
        };

        delete {
            bindings = <&kp DEL>;
            key-positions = <10 9>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        ROTATE: ROTATE {
            compatible = "zmk,behavior-sensor-rotate-var";
            label = "ROTATE";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&lt 6 ESC  &kp Q               &kp W         &kp E         &kp R                    &kp T                                      &kp Y        &kp U  &kp I      &kp O    &kp P                     &kp BSPC
&kp TAB    &lt_to_layer_0 5 A  &kp S         &kp D         &kp F                    &kp G        &mkp MCLK    &kp EXCLAMATION  &kp H        &kp J  &kp K      &lt 4 L  &lt 5 MINUS               &kp ENTER
&kp LSHFT  &mt LEFT_SHIFT Z    &kp X         &kp C         &kp V                    &kp B        &kp B        &kp AT           &kp N        &kp M  &kp COMMA  &kp DOT  &mt RSHFT SLASH           &kp RSHFT
&kp LCTRL  &kp LEFT_CONTROL    &kp LEFT_GUI  &kp LEFT_ALT  &kp LANG_ZENKAKUHANKAKU  &lt 1 SPACE  &kp TAB      &kp BACKSPACE    &lt 2 ENTER                             &mt RIGHT_ALT UNDERSCORE  &kp RCTRL
            >;

            sensor-bindings = <&ROTATE SCRL_DOWN SCRL_UP>;
        };

        NUN-FUNCTION {
            bindings = <
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3     &kp N4       &kp N5                                          &kp NUMBER_6  &kp N7  &kp N8  &kp N9  &kp N0   &trans
&trans  &kp F1        &kp F2        &kp F3           &kp F4       &kp F5               &trans             &trans  &kp F6        &kp F7  &kp F8  &kp F9  &kp F10  &trans
&trans  &kp F11       &kp F12       &kp LS(LC(TAB))  &kp LC(TAB)  &kp LS(LA(LC(TAB)))  &kp LA(LC(TAB))    &trans  &trans        &trans  &trans  &trans  &trans   &trans
&trans  &trans        &trans        &trans           &mkp MB4     &trans               &mkp MB5           &trans  &trans                                &trans   &trans
            >;
        };

        Symbol {
            bindings = <
&trans  &kp EXCLAMATION       &kp AT_SIGN      &kp HASH   &kp DOLLAR         &kp PERCENT                                                    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp TILDE      &kp EQUAL  &kp NON_US_BACKSLASH  &trans
&trans  &kp AT_SIGN           &kp DOLLAR       &kp SQT    &kp DOUBLE_QUOTES  &kp BACKSLASH  &kp LC(LA(KP_NUMBER_0))    &kp INT_KANA         &kp LEFT_BRACKET      &kp RBKT               &kp SEMICOLON  &kp COLON  &kp TILDE             &trans
&trans  &mt LEFT_SHIFT SLASH  &kp KP_NUMBER_1  &kp MINUS  &kp PLUS           &kp PERIOD     &kp DELETE                 &kp INTERNATIONAL_1  &kp LEFT_BRACE        &kp RBRC               &kp PIPE       &kp GRAVE  &kp SLASH             &trans
&trans  &trans                &trans           &trans     &kp LANGUAGE_8     &trans         &kp LANGUAGE_4             &trans               &trans                                                                 &kp UNDERSCORE        &trans
            >;
        };

        ARROW {
            bindings = <
&trans  &kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &trans                     &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans   &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans                  &trans          &trans                   &trans   &trans    &trans  &trans                          &trans  &trans
            >;

            sensor-bindings = <&ROTATE SCRL_DOWN SCRL_UP>;
        };

        MOUSE {
            bindings = <
&trans  &kp Q        &kp W        &kp E     &kp R     &kp T                                    &kp Y     &kp U     &kp I      &kp O        &kp P             &trans
&trans  &lt 5 SPACE  &lt 4 SPACE  &mkp MB2  &mkp MB1  &mkp MB3  &mkp MB3      &kp EXCLAMATION  &mkp MB3  &mkp MB1  &mkp MB2   &lt 4 SPACE  &kp MINUS         &trans
&trans  &kp Z        &kp X        &kp C     &kp V     &kp B     &kp DELETE    &kp AT           &kp N     &kp M     &kp COMMA  &kp DOT      &mt RSHIFT SLASH  &trans
&trans  &trans       &trans       &trans    &trans    &trans    &trans        &trans           &trans                                      &trans            &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &kp C_VOLUME_UP    &kp PAGE_UP     &kp UP_ARROW    &kp HOME   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp C_VOLUME_DOWN  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp K_MUTE         &kp PAGE_DOWN   &trans          &kp END    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                                                        &trans  &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans        &trans        &trans        &trans                       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans
&trans  &trans  &trans        &trans        &trans        &trans     &trans    &trans  &trans        &trans        &trans        &trans        &trans          &trans
&trans  &trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kt KP_N4  &trans    &trans  &trans        &trans        &trans        &trans        &bt BT_CLR      &bt BT_CLR
&trans  &trans  &trans        &trans        &trans        &trans     &trans    &trans  &trans                                                  &bt BT_CLR_ALL  &bt BT_CLR_ALL
            >;
        };

        layer_7 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans  &trans
            >;
        };
    };
};
